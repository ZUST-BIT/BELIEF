# ==================== LLM 后端配置 ====================
# 可选值: "api" | "ollama" | "vllm" | "transformers"
MEDAR_LLM_BACKEND=ollama

# OpenAI 兼容 API（LLM_BACKEND=api 时生效）
MEDAR_API_URL=https://api.gptsapi.net/v1
MEDAR_API_KEY=sk-your-key-here
MEDAR_MODEL_NAME=gpt-4o-mini

# Ollama（LLM_BACKEND=ollama 时生效）
MEDAR_OLLAMA_URL=http://localhost:11434
MEDAR_OLLAMA_MODEL=qwen2.5:7b

# vLLM（LLM_BACKEND=vllm 时生效）
MEDAR_VLLM_URL=http://localhost:8001/v1
MEDAR_VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# 本地 Transformers（LLM_BACKEND=transformers 时生效）
MEDAR_LOCAL_MODEL_PATH=Qwen/Qwen2.5-7B-Instruct
MEDAR_DEVICE=cuda

# ==================== Think 模式控制 ====================
# Qwen3 等模型建议开启以节省 token
MEDAR_DISABLE_THINKING=true

# ==================== PubMed / NCBI E-utilities ====================
# NCBI recommends identifying the tool and a contact email. An API key is
# optional, but useful for larger baseline runs and higher request limits.
MEDAR_NCBI_TOOL=MEDAR-QA
MEDAR_NCBI_EMAIL=your-email@example.com
MEDAR_NCBI_API_KEY=

# ==================== 数据库配置（可选） ====================
MEDAR_NEO4J_USR=neo4j
MEDAR_NEO4J_PWD=your-password
MEDAR_NEO4J_URL=bolt://localhost:7687
MEDAR_MONGO_URL=mongodb://localhost:27017/
MEDAR_DB_NAME=bio
MEDAR_COLLECTION_NAME=pubmed

# ==================== FAISS / 向量检索配置 ====================
MEDAR_EMBEDDING_MODEL_ZH=BAAI/bge-large-zh
MEDAR_EMBEDDING_MODEL_EN=BAAI/bge-large-en-v1.5
MEDAR_FAISS_INDEX_PATH_OMIC=output/faiss_index_omic.bin
MEDAR_FAISS_MAPPING_PATH_OMIC=output/faiss_mapping_omic.json
MEDAR_FAISS_INDEX_PATH_BIO=output/faiss_index_bio.bin
MEDAR_FAISS_MAPPING_PATH_BIO=output/faiss_mapping_bio.json
MEDAR_FAISS_INDEX_PATH_HCC=output/faiss_index_hcc.bin
MEDAR_FAISS_MAPPING_PATH_HCC=output/faiss_mapping_hcc.json

# ==================== 数据路径配置（按需修改） ====================
MEDAR_INPUT_DIR=D:/BitLabData/bio关键文档/outputs_final
MEDAR_FACT_JSONL=datafile/fact_corpus_explanatory.jsonl
MEDAR_FACT_JSONL_HCC=D:/BitLabData/bio关键文档/facts_cache.jsonl
MEDAR_MESH_MAPPING_PATH=D:/BitLabData/MeSH/mesh_mapping.json
MEDAR_MESH_INFO_PATH=D:/BitLabData/MeSH/mesh_info.json

# ==================== 通用参数 ====================
MEDAR_PROJECT=BELIEF
MEDAR_BATCH_SIZE=32
